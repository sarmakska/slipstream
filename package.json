{
  "name": "slipstream",
  "version": "0.30.0",
  "description": "A Claude Code plugin: a bundled MCP server for scoped retrieval, lossless compaction via a PreCompact digest, smart memory recall, shipped subagents, a context-budget statusline and a live local agent dashboard for shipping production sites on Cloudflare, Supabase, Vercel and Resend.",
  "type": "module",
  "license": "MIT",
  "author": "Sarma",
  "homepage": "https://github.com/sarmakska/slipstream",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarmakska/slipstream.git"
  },
  "bin": {
    "slipstream": "./dist/cli/index.js",
    "slipstream-setup": "./dist/cli/setup-bin.js"
  },
  "files": [
    "dist",
    "skills",
    "commands",
    "agents",
    "hooks",
    "statusline",
    "output-styles",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "build:server": "tsc -p tsconfig.build.json",
    "web:build": "vite build --config web/vite.config.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node dist/cli/index.js validate",
    "plugin-validate": "node dist/cli/index.js plugin-validate",
    "benchmark": "node scripts/benchmark-token-savings.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "d3-force": "^3.0.0",
    "eslint": "^9.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8",
    "wouter": "^3.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
