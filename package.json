{
  "name": "slipstream",
  "version": "0.7.1",
  "description": "A Claude Code plugin: a bundled MCP server for scoped retrieval, lossless compaction via a PreCompact digest, smart memory recall, shipped subagents, a context-budget statusline and a live local agent dashboard for shipping production sites on Cloudflare, Supabase, Vercel and Resend.",
  "type": "module",
  "license": "MIT",
  "author": "Sarma",
  "homepage": "https://github.com/sarmakska/slipstream",
  "repository": {
    "type": "git",
    "url": "https://github.com/sarmakska/slipstream.git"
  },
  "bin": {
    "slipstream": "./dist/cli/index.js",
    "slipstream-setup": "./dist/cli/setup-bin.js"
  },
  "files": [
    "dist",
    "skills",
    "commands",
    "agents",
    "hooks",
    "statusline",
    "output-styles",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node dist/cli/index.js validate",
    "plugin-validate": "node dist/cli/index.js plugin-validate"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
